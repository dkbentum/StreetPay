<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StreetPay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#4CAF50</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Re-centering the logo as the main icon -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/my_splash</item>
        <!-- Matching the background of your image -->
        <item name="windowSplashScreenBackground">#006437</item>
        <item name="postSplashScreenTheme">@style/Theme.StreetPay</item>
    </style>
</resources>